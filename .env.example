# Bakes a Supabase project into the build so anyone who opens the site can
# create an account and have their logs follow them across devices. Leave
# both unset and the app only offers "Use without an account" (data stays
# in that browser / phone).
#
# The anon key is safe to expose — Supabase ships it in every client by
# design. Row-level security (supabase/setup.sql) is what keeps each
# person's logs private.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Native (Android/iOS) builds are made locally, so put the same two values
# in .env.capacitor.local (git-ignored) before `npm run cap:sync`.

# The public site the installed apps check for updates and download the
# APK from, e.g. https://ironward.example.com (no trailing slash). Unset =
# the apps never check for updates.
VITE_UPDATE_BASE_URL=

# "1" shows "Continue with Google" on the website. Turn on the Google
# provider in Supabase (Authentication → Sign In / Providers) first.
VITE_ENABLE_GOOGLE=
