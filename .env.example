# Google sign-in. The client ID is public by design (it identifies the app
# to Google). Leave it unset and the app only offers "Use without an
# account" (data stays in that browser / phone).
VITE_GOOGLE_CLIENT_ID=

# Server-side only, set in the Vercel project (never a VITE_ var). They are
# read by api/google-token.ts, which swaps Google's codes for tokens:
#   GOOGLE_CLIENT_ID      same value as VITE_GOOGLE_CLIENT_ID
#   GOOGLE_CLIENT_SECRET  from the same OAuth client

# Native (Android/iOS) builds are made locally; put the values above in
# .env.capacitor.local (git-ignored) before `npm run cap:sync`.

# The public site the installed apps check for updates and download the
# APK from, e.g. https://ironward.example.com (no trailing slash). Unset =
# the apps never check for updates.
VITE_UPDATE_BASE_URL=
